# OpenAI
OPENAI_API_KEY=your_openai_api_key

# YouTube Data API v3 (console.cloud.google.com → Enable "YouTube Data API v3")
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPE=user-read-playback-state user-modify-playback-state user-read-currently-playing

# Tapo
TAPO_IP=192.168.1.192
TAPO_EMAIL=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_password
